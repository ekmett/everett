module;
#include <cstdint>
#include <optional>
#include <string>

export module everett.avx2;
export import everett;
export import simd.avx2;

export namespace everett {
  template <class Registry = unsorted<std::optional<std::string>>,
            std::uint64_t GroupSize = 15, class BackspaceCode = exponential_golomb<0>,
            std::uint64_t CodecBlockSize = GroupSize>
  using avx2_policy = backend_policy<simd::avx2, Registry, GroupSize, BackspaceCode, CodecBlockSize>;
}
