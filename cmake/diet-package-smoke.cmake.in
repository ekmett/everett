# \brief Checks Diet package relocation and embedded consumption.

cmake_minimum_required(VERSION 3.20)

function(diet_run)
  execute_process(COMMAND ${ARGV} RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if(NOT result EQUAL 0)
    string(JOIN " " command ${ARGV})
    message(FATAL_ERROR "Command failed (${result}): ${command}\n${output}\n${error}")
  endif()
endfunction()

if(NOT diet_smoke_mode MATCHES "^(installed|embedded)$")
  message(FATAL_ERROR "Unknown package smoke-test mode")
endif()
set(root "@PROJECT_BINARY_DIR@/package-smoke/${diet_smoke_mode}")
file(REMOVE_RECURSE "${root}")
file(MAKE_DIRECTORY "${root}")
set(config_args)
if(NOT "${diet_smoke_config}" STREQUAL "")
  list(APPEND config_args --config "${diet_smoke_config}")
endif()

set(mode_args "-DDIET_PACKAGE_MODE=${diet_smoke_mode}")
if(diet_smoke_mode STREQUAL "installed")
  diet_run("@CMAKE_COMMAND@" --install "@PROJECT_BINARY_DIR@"
    --prefix "${root}/original" ${config_args})
  # Remove the original prefix by moving it, so an accidentally hardcoded
  # install path cannot make the consumer appear relocatable.
  file(RENAME "${root}/original" "${root}/relocated")
  foreach(notice IN ITEMS LICENSE THIRD_PARTY.md LICENSES/BSD-2-Clause.txt LICENSES/Apache-2.0.txt
      third_party/fast-crc32/LICENSE.md third_party/fast-crc32/LICENSE.MIT.md
      third_party/fast-crc32/LICENSE.zlib.md third_party/fast-crc32/UPSTREAM.md)
    set(installed_notice "${root}/relocated/@CMAKE_INSTALL_DATADIR@/diet/${notice}")
    if(NOT EXISTS "${installed_notice}")
      message(FATAL_ERROR "Installed package is missing ${notice}")
    endif()
    diet_run("@CMAKE_COMMAND@" -E compare_files "@PROJECT_SOURCE_DIR@/${notice}" "${installed_notice}")
  endforeach()
  foreach(backend IN ITEMS portable arm_scalar arm_pmull arm_eor3 x86_scalar x86_pclmul x86_avx512 x86_vpclmul)
    set(header "diet/detail/crc32c_${backend}.inc")
    diet_run("@CMAKE_COMMAND@" -E compare_files "@PROJECT_SOURCE_DIR@/include/${header}"
      "${root}/relocated/@CMAKE_INSTALL_INCLUDEDIR@/${header}")
  endforeach()
  list(APPEND mode_args "-DCMAKE_PREFIX_PATH=${root}/relocated"
    "-DDIET_EXPECTED_PREFIX=${root}/relocated"
    -DCMAKE_FIND_USE_PACKAGE_REGISTRY=OFF -DCMAKE_FIND_USE_SYSTEM_PACKAGE_REGISTRY=OFF)
else()
  list(APPEND mode_args "-DDIET_SOURCE_DIR=@PROJECT_SOURCE_DIR@")
endif()
set(generator_args -G "@CMAKE_GENERATOR@")
if(NOT "@CMAKE_GENERATOR_PLATFORM@" STREQUAL "")
  list(APPEND generator_args -A "@CMAKE_GENERATOR_PLATFORM@")
endif()
if(NOT "@CMAKE_GENERATOR_TOOLSET@" STREQUAL "")
  list(APPEND generator_args -T "@CMAKE_GENERATOR_TOOLSET@")
endif()
diet_run("@CMAKE_COMMAND@" -S "@PROJECT_SOURCE_DIR@/tests/package" -B "${root}/consumer"
  ${generator_args} "-DCMAKE_CXX_COMPILER=@CMAKE_CXX_COMPILER@"
  "-DCMAKE_MAKE_PROGRAM=@CMAKE_MAKE_PROGRAM@" "-DCMAKE_BUILD_TYPE=@CMAKE_BUILD_TYPE@"
  ${mode_args})
diet_run("@CMAKE_COMMAND@" --build "${root}/consumer" ${config_args} --parallel 4)
diet_run("@CMAKE_CTEST_COMMAND@" --test-dir "${root}/consumer"
  -C "${diet_smoke_config}" --output-on-failure)
