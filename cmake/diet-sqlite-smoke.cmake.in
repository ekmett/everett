# \brief Checks the optional SQLite component and dependency-free core after installation.

cmake_minimum_required(VERSION 3.20)
function(diet_run)
  execute_process(COMMAND ${ARGV} RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if(NOT result EQUAL 0)
    message(FATAL_ERROR "SQLite package check failed: ${ARGV}\n${output}\n${error}")
  endif()
endfunction()
set(root "@PROJECT_BINARY_DIR@/sqlite-package-smoke")
file(REMOVE_RECURSE "${root}")
file(MAKE_DIRECTORY "${root}/source")
set(config_args)
if(NOT "${diet_smoke_config}" STREQUAL "")
  list(APPEND config_args --config "${diet_smoke_config}")
endif()
diet_run("@CMAKE_COMMAND@" --install "@PROJECT_BINARY_DIR@" --prefix "${root}/original" ${config_args})
file(RENAME "${root}/original" "${root}/relocated")
file(WRITE "${root}/source/CMakeLists.txt" [=[
cmake_minimum_required(VERSION 3.20)
project(diet_sqlite_consumer LANGUAGES CXX)
if(CORE_ONLY)
  set(CMAKE_DISABLE_FIND_PACKAGE_SQLite3 TRUE)
  find_package(diet CONFIG REQUIRED)
  if(TARGET diet::sqlite OR TARGET SQLite::SQLite3)
    message(FATAL_ERROR "Core consumer acquired a SQLite dependency")
  endif()
  add_executable(consumer core.cc)
  target_link_libraries(consumer PRIVATE diet::diet)
else()
  find_package(diet CONFIG REQUIRED COMPONENTS sqlite)
  add_executable(consumer sqlite.cc)
  target_link_libraries(consumer PRIVATE diet::sqlite)
endif()
enable_testing()
add_test(NAME consumer COMMAND consumer)
]=])
file(WRITE "${root}/source/core.cc" [=[
#include <diet/policy.h>
int main() { return diet::storage_policy<diet::tip<diet::encoded_sort<diet::byte_encoding<>>>>::group_size != 15; }
]=])
file(WRITE "${root}/source/sqlite.cc" [=[
#include <diet/connection.h>
int main() {
#if defined(__APPLE__) || defined(__linux__)
  auto pantry = diet::fridge<>::create("example-data");
  auto db = pantry.connect("earth-616");
  db.put("name", "Diet");
  auto before = db.snapshot();
  db.save("before-edit", before);
  db.put("name", "A reduced COLA");
  if (before.get("name") != "Diet" || db.get("name") != "A reduced COLA") return 1;
  auto saved = db.load("before-edit");
  if (!saved) return 2;
  auto branch = db.fork("earth-617", *saved);
  branch.put("name", "Another branch");
  if (branch.get("name") != "Another branch" || saved->get("name") != "Diet") return 3;
  auto base = db.snapshot();
  auto left = base.put("partition/a", "updated A");
  auto right = base.put("partition/b", "updated B");
  db.apply(std::move(right)); db.apply(std::move(left));
  auto ticket = db.put_async("async", "done");
  ticket.get();
  return db.get("async") != "done";
#else
  return 0;
#endif
}
]=])
set(generator_args -G "@CMAKE_GENERATOR@")
if(NOT "@CMAKE_GENERATOR_PLATFORM@" STREQUAL "")
  list(APPEND generator_args -A "@CMAKE_GENERATOR_PLATFORM@")
endif()
if(NOT "@CMAKE_GENERATOR_TOOLSET@" STREQUAL "")
  list(APPEND generator_args -T "@CMAKE_GENERATOR_TOOLSET@")
endif()
foreach(mode IN ITEMS component core)
  if(mode STREQUAL "core")
    set(mode_args -DCORE_ONLY=ON)
  else()
    set(mode_args "-DSQLite3_INCLUDE_DIR=@SQLite3_INCLUDE_DIR@" "-DSQLite3_LIBRARY=@SQLite3_LIBRARY@")
  endif()
  diet_run("@CMAKE_COMMAND@" -S "${root}/source" -B "${root}/${mode}"
    ${generator_args} "-DCMAKE_CXX_COMPILER=@CMAKE_CXX_COMPILER@" "-DCMAKE_BUILD_TYPE=@CMAKE_BUILD_TYPE@"
    "-DCMAKE_MAKE_PROGRAM=@CMAKE_MAKE_PROGRAM@"
    "-DCMAKE_PREFIX_PATH=${root}/relocated"
    -DCMAKE_FIND_USE_PACKAGE_REGISTRY=OFF -DCMAKE_FIND_USE_SYSTEM_PACKAGE_REGISTRY=OFF ${mode_args})
  diet_run("@CMAKE_COMMAND@" --build "${root}/${mode}" ${config_args} --parallel 4)
  diet_run("@CMAKE_CTEST_COMMAND@" --test-dir "${root}/${mode}" -C "${diet_smoke_config}" --output-on-failure)
endforeach()
