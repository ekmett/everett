# \brief Configures Everett's installed package.

@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(Threads)
find_dependency(simd 0.0.1 CONFIG COMPONENTS simd)
include("${CMAKE_CURRENT_LIST_DIR}/everett-targets.cmake")
set(everett_everett_FOUND TRUE)
set(everett_PROFILES "@EVERETT_PROFILES@")
foreach(everett_component IN LISTS everett_FIND_COMPONENTS)
  if(everett_component STREQUAL "sqlite" AND
      EXISTS "${CMAKE_CURRENT_LIST_DIR}/everett-sqlite-targets.cmake")
    include(CMakeFindDependencyMacro)
    find_dependency(SQLite3 3.51.3)
    include("${CMAKE_CURRENT_LIST_DIR}/everett-sqlite-targets.cmake")
    set(everett_sqlite_FOUND TRUE)
  elseif(everett_component MATCHES "^(everett|neon|avx2|avx512)$" AND
         TARGET everett::${everett_component})
    set(everett_${everett_component}_FOUND TRUE)
  else()
    set(everett_${everett_component}_FOUND FALSE)
  endif()
endforeach()
check_required_components(everett)
