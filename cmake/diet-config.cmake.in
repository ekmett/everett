# \brief Configures Diet's installed package.

@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(Threads)
include("${CMAKE_CURRENT_LIST_DIR}/diet-targets.cmake")
foreach(diet_component IN LISTS diet_FIND_COMPONENTS)
  if(diet_component STREQUAL "sqlite" AND
      EXISTS "${CMAKE_CURRENT_LIST_DIR}/diet-sqlite-targets.cmake")
    include(CMakeFindDependencyMacro)
    find_dependency(SQLite3 3.51.3)
    include("${CMAKE_CURRENT_LIST_DIR}/diet-sqlite-targets.cmake")
    set(diet_sqlite_FOUND TRUE)
  else()
    set(diet_${diet_component}_FOUND FALSE)
  endif()
endforeach()
check_required_components(diet)
